<Application x:Class="TomeUnlocker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#FF1A1B20"/>
        <SolidColorBrush x:Key="CardBorder" Color="#40414A"/>
        <SolidColorBrush x:Key="Surface" Color="#242631"/>
        <SolidColorBrush x:Key="SurfaceBorder" Color="#3A3C46"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="BadBrush" Color="#FFE74C3C"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#34C759"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="NeonPurple" Color="#8A35FF"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#2D3040"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#292C39"/>
        <SolidColorBrush x:Key="ShadowColor" Color="#AA000000"/>
        <SolidColorBrush x:Key="LoadingOverlayColor" Color="#80000000"/>
    </Application.Resources>
</Application>
