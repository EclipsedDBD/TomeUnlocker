<Window x:Class="TomeUnlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tome Unlocker"
        Height="420" Width="740"
        MinHeight="420" MinWidth="740"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Opacity="1">
    <Window.Resources>
        <Style x:Key="PurpleScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="0"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="#15161A"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="#15161A"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#8B5CF6" CornerRadius="4" Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReadonlyInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,0,42,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource NeonPurple}"/>
                                <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <ControlTemplate.Resources>
                            <Storyboard x:Key="TurnOn">
                                <ColorAnimation Storyboard.TargetName="TrackColor" Storyboard.TargetProperty="Color" To="#8B5CF6" Duration="0:0:0.2">
                                    <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                </ColorAnimation>
                                <ColorAnimation Storyboard.TargetName="TrackBorderColor" Storyboard.TargetProperty="Color" To="#8B5CF6" Duration="0:0:0.2">
                                    <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                </ColorAnimation>
                                <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                            <Storyboard x:Key="TurnOff">
                                <ColorAnimation Storyboard.TargetName="TrackColor" Storyboard.TargetProperty="Color" To="#242631" Duration="0:0:0.2">
                                    <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                </ColorAnimation>
                                <ColorAnimation Storyboard.TargetName="TrackBorderColor" Storyboard.TargetProperty="Color" To="#3A3C46" Duration="0:0:0.2">
                                    <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                </ColorAnimation>
                                <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </ControlTemplate.Resources>
                        <Grid x:Name="Root" Width="44" Height="24">
                            <Border x:Name="Track" CornerRadius="12" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackColor" Color="#242631"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="TrackBorderColor" Color="#3A3C46"/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                </Border.RenderTransform>
                                <Border.Background>
                                    <SolidColorBrush Color="#ECECEC"/>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ThumbGlow" Color="#8B5CF6" BlurRadius="6" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource TurnOn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource TurnOff}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainCard"
                Margin="10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="12"
                MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#AA000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource NeonPurple}" Opacity="0.85" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="TOME UNLOCKER" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="VersionText" Margin="8,0,0,0"
                               Text="v1.0.0" Foreground="{DynamicResource TextMuted}"
                               FontSize="10" Opacity="0.45" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Style="{StaticResource CloseButton}"
                            Click="CloseButton_Click" ToolTip="Close">
                        <Grid>
                            <Line X1="0" Y1="0" X2="10" Y2="10"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"/>
                            <Line X1="10" Y1="0" X2="0" Y2="10"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"/>
                        </Grid>
                    </Button>
                </Grid>

                <Rectangle Grid.Row="1" Fill="{DynamicResource NeonPurple}" Opacity="0.25"
                           Margin="18,0,18,0"/>

                <Grid Grid.Row="2" Margin="20,14,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="8"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" Height="34">
                        <Grid>
                            <TextBox x:Name="ApiKeyBox"
                                     Style="{StaticResource ReadonlyInput}"
                                     Text="Start the Game"
                                     Opacity="0.55"/>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="4,0,4,0"
                                    Style="{StaticResource RoundIconButton}"
                                    ToolTip="Copy API Key"
                                    Click="CopyApiKey_Click">
                                <Path Data="M3,6 L3,15 L12,15 L12,6 z M6,3 L15,3 L15,12 L13,12 L13,6 L7,6 L7,3 z"
                                      Fill="{DynamicResource TextPrimary}"
                                      Stretch="Uniform"
                                      Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock x:Name="MatchCountText" Text="0" Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource NeonPurple}"/>
                            <TextBlock Text="MATCHES" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock x:Name="ChallengeCountText" Text="0" Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource GoodBrush}"/>
                            <TextBlock Text="COMPLETED" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="PlatformText" Text="--" Style="{StaticResource StatNumber}" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="PLATFORM" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock x:Name="MatchIdDisplay" Text="--" Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="16"
                                       TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                            <TextBlock Text="MATCH ID" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ProxyDot" Width="7" Height="7" Fill="{DynamicResource BadBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ProxyStatus" Text="Proxy Stopped" Style="{StaticResource StatusValue}"
                                   Foreground="{DynamicResource BadBrush}" Margin="7,0,24,0"/>
                        <Ellipse Grid.Column="3" x:Name="TomeDot" Width="7" Height="7" Fill="{DynamicResource BadBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" x:Name="TomeActiveStatus" Text="Tome Inactive" Style="{StaticResource StatusValue}"
                                   Foreground="{DynamicResource BadBrush}" Margin="7,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LOG" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource TextMuted}" Opacity="0.4"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource RoundIconButton}"
                                    Width="20" Height="20"
                                    ToolTip="Copy Log"
                                    Click="CopyLog_Click">
                                <Path Data="M3,6 L3,15 L12,15 L12,6 z M6,3 L15,3 L15,12 L13,12 L13,6 L7,6 L7,3 z"
                                      Fill="{DynamicResource TextMuted}"
                                      Stretch="Uniform"
                                      Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <Border Grid.Row="2" CornerRadius="6"
                                Background="#15161A"
                                BorderThickness="0">
                            <ScrollViewer x:Name="LogScrollView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource PurpleScrollBar}"/>
                                </ScrollViewer.Resources>
                                <TextBox x:Name="LogBox"
                                         IsReadOnly="True"
                                         Focusable="False"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextMuted}"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Opacity="0.7"
                                         Padding="8,6"
                                         TextWrapping="NoWrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" x:Name="LastActionText" Text="Ready"
                                   Foreground="{DynamicResource TextMuted}" FontSize="11"
                                   HorizontalAlignment="Center" Opacity="0.5" Margin="0,6,0,0"/>
                    </Grid>
                </Grid>

                <Border x:Name="LoadingOverlay"
                        Grid.RowSpan="3"
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="12"
                    Opacity="1" Visibility="Visible">
                <Grid>
                    <Border x:Name="LoadingImageBorder" CornerRadius="12" Opacity="0">
                        <Border.Background>
                            <ImageBrush x:Name="LoadingOverlayImage" Stretch="Fill"/>
                        </Border.Background>
                    </Border>
                    <Border Background="{DynamicResource LoadingOverlayColor}" CornerRadius="12">
                        <Grid>
                            <TextBlock x:Name="LoadingStatusText"
                                       Text="Initializing..."
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="1">
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="LoadingTextGlow" Color="#A855F7"
                                                      BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Window>